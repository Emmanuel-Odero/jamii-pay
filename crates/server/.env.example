# Copy to crates/server/.env (gitignored) and fill in real values from
# developer.safaricom.co.ke. Without these, POST /wallets/:id/mpesa/stk-push
# returns a 400 explaining M-Pesa isn't configured — everything else in
# the app works fine without it.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# The paybill/till the STK Push debits into.
DARAJA_SHORTCODE=
# Lipa Na M-Pesa Online passkey, paired with DARAJA_SHORTCODE.
DARAJA_PASSKEY=
# https://sandbox.safaricom.co.ke while testing; switch to
# https://api.safaricom.co.ke only once go-live approved. Defaults to
# sandbox if unset.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
# MUST be public HTTPS — Safaricom's servers call this directly over the
# internet and can never reach a LAN/mDNS address. For local dev, run
# `ngrok http 8081` and paste the https://*.ngrok-free.app URL here
# (with /mpesa/callback appended), then restart the server — ngrok's
# free-tier URL changes every restart, so this has to be updated each
# session you test M-Pesa with.
DARAJA_CALLBACK_URL=

# --- Cash-out (B2C — paying a real M-Pesa number) — see
# crates/server/src/daraja.rs's module doc comment for full setup
# instructions (a separate Daraja app from STK Push, plus Safaricom's
# public certificate reduced to a PEM public key). Without these,
# POST /wallets/:id/cash-out returns a 400 explaining Cash-out isn't
# configured — everything else in the app works fine without it.
# The B2C-enabled shortcode (Safaricom's own float account it pays out
# of) — not necessarily the same shortcode DARAJA_SHORTCODE uses.
DARAJA_B2C_SHORTCODE=
# The Daraja app's API operator username, not a phone number.
DARAJA_B2C_INITIATOR_NAME=
# The initiator's plaintext operator password — encrypted per-request
# with Safaricom's public key before it's ever sent, never stored
# encrypted here (there's nothing gained by pre-encrypting it: Daraja
# needs a *fresh* SecurityCredential per request anyway).
DARAJA_B2C_INITIATOR_PASSWORD=
# Path to Safaricom's public key, extracted from their certificate via
# `openssl x509 -in SandboxCertificate.cer -pubkey -noout > pubkey.pem`
# (sandbox and production have different certs).
DARAJA_B2C_PUBLIC_KEY_PATH=
# Same ngrok-tunnel requirement as DARAJA_CALLBACK_URL above — public
# HTTPS, Safaricom calls these directly. The one tunnel covers both
# paths.
DARAJA_B2C_RESULT_URL=
DARAJA_B2C_TIMEOUT_URL=

# --- Card top-up (Stripe Checkout) — see routes/card_topup.rs ---------
# From dashboard.stripe.com/apikeys.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create at dashboard.stripe.com/webhooks,
# pointing at <public-url>/stripe/webhook (subscribed to
# checkout.session.completed). The SAME ngrok tunnel above works for
# both DARAJA_CALLBACK_URL and this — ngrok exposes the whole port 8081,
# not just one path.
STRIPE_WEBHOOK_SECRET=
# Where the post-checkout success/cancel page loads — this one only
# needs to be reachable from the *payer's own phone browser*, not the
# public internet, so the existing mDNS address works and is the
# default if unset.
PUBLIC_BASE_URL=http://Ochiengs-MacBook-Pro.local:8081

# --- Base Sepolia (real on-chain settlement) — everything the app does
# runs fine on the database-only ledger without these; nothing on-chain
# works until both are set.
# A free RPC endpoint for Base Sepolia — create an app scoped to "Base
# Sepolia" at https://www.alchemy.com/ (or Infura/QuickNode) and paste
# its HTTPS URL here.
BASE_SEPOLIA_RPC_URL=
# Pays gas for smart-account deployment + sponsored UserOperations.
# Generate one with `cast wallet new` (Foundry), then fund the resulting
# address from a Base Sepolia faucet (e.g. Coinbase's or Alchemy's) —
# testnet ETH only, never a key holding anything real.
DEPLOYER_PRIVATE_KEY=
