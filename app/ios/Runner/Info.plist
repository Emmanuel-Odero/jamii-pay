<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Jamiipay</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>jamiipay</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to unlock JamiiPay instead of typing your PIN.</string>
	<key>NSCameraUsageDescription</key>
	<string>Used to scan a JamiiPay QR code to send a payment, or to read your wallet key QR code when restoring your wallet.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used to upload the wallet key QR code you downloaded, when restoring your wallet.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>JamiiPay connects to the developer server on your local network during development.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- DEV-ONLY: the app talks to `crates/server` over plain HTTP at the
		     Mac's LAN IP (see `JamiiPayApiClient`, currently 10.45.3.194).
		     iOS blocks cleartext to bare IPs, and `NSExceptionDomains`
		     cannot express IP literals — so without this, the physical
		     phone reaches NO backend endpoint (no sends land, no polls
		     succeed, the balance WebSocket never connects, and therefore
		     no money/message notification can ever fire). The old `.local`
		     exception below is kept for mDNS hosts. REMOVE this key (or
		     scope it) before any production/TestFlight build — production
		     must use https, at which point ATS protects everything again. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>local</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Lets iOS wake the app briefly for pushes carrying content
		     and deliver taps to a suspended app. Display pushes reach a
		     terminated app regardless; this keeps the suspended path warm. -->
		<string>remote-notification</string>
	</array>
</dict>
</plist>
